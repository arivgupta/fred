# Backend origin. Leave empty in local dev (Vite proxies /api/* to
# http://localhost:8000) or set to the deployed backend URL in prod.
VITE_API_BASE_URL=

# Google OAuth client id. If unset, Google sign-in buttons are hidden and
# email/password auth is used.
VITE_GOOGLE_CLIENT_ID=

# Phone number shown on the Home "text G directly" card (optional).
VITE_G_PHONE_NUMBER=
